NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://locoomo:locoomo@localhost:5434/locoomo
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
# Signs public parcel-tracking links in emails. Same generation command as
# above; rotating it invalidates links already sent.
TRACKING_LINK_SECRET=
# Only needed against a hosted DB (Supabase/Neon) that requires TLS — repo-relative
# path to that provider's CA cert (e.g. certs/supabase-ca.crt). Unset locally, the
# docker-compose Postgres has no TLS.
DATABASE_SSL_CA_PATH=
# Comma-separated browser origins allowed to call this API with credentials
CORS_ORIGIN=http://localhost:5173
# Single canonical frontend origin — used to build links embedded in emails
# (password reset, email verification, invite)
FRONTEND_URL=http://localhost:5173
# SMTP only — no provider SDK, so swapping providers is just changing these
# values. Resend's own relay for the pilot: host smtp.resend.com, user
# "resend", password = a Resend API key. Any other SMTP-capable provider
# (SES, Postmark, SendGrid, Mailgun, ...) works the same way. Use Resend's
# implicit-TLS port 465 (secure=true), not 587 — some ISPs/routers block
# outbound 587 to stop spam relaying (see doc/DEVELOPMENT.md gotchas).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Some hosts block outbound SMTP entirely (Railway free/hobby tier does, on
# every port — see doc/DEVELOPMENT.md gotchas). Set EMAIL_TRANSPORT=resend_api
# there to send over Resend's HTTPS API instead (443, never blocked). Leave
# unset/"smtp" everywhere else — this only exists as a fallback.
EMAIL_TRANSPORT=smtp
# Required only when EMAIL_TRANSPORT=resend_api. Same Resend API key as
# SMTP_PASSWORD above, just under its own var name.
RESEND_API_KEY=
# Rider verification document uploads (screenshots) — signed direct-to-Cloudinary
# upload, never proxied through this API. From your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Paystack TEST secret key (dashboard > Settings > API Keys & Webhooks) —
# hosted-redirect checkout, so no client-side public key is needed here.
PAYSTACK_SECRET_KEY=
# Optional. Merchant test-mode wallet top-ups (sk_test_…). Unset: test top-ups
# use PAYSTACK_SECRET_KEY when it is a test key (staging), else are off.
PAYSTACK_TEST_SECRET_KEY=
# Optional. Bank for merchant Dedicated Virtual Accounts. Default: test-bank
# with a test key, wema-bank with a live key.
PAYSTACK_DVA_PREFERRED_BANK=
# Google Sign-In — OAuth 2.0 Client ID from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application). Public
# value, not a secret. No client secret needed — we only verify a client-side
# ID token server-side, never a server-side auth-code exchange.
GOOGLE_CLIENT_ID=
# Google Maps Platform SERVER key — checks each Node's map pin against its
# typed address (rejects pins that are clearly in the wrong place). Key
# settings: Application restrictions = None (a referrer-restricted browser key
# is rejected by Google for server-side calls), API restrictions = Geocoding
# API only, and billing enabled on the project. Not the frontend's map key —
# that's a separate, referrer-restricted browser key (doc/API.md › Map pin
# picker). Optional — leave empty and Nodes are created with locationCheck
# "unverified" instead.
GOOGLE_MAPS_API_KEY=
# Sendii courier (https://developers.sendii.ng). sk_test_… for the sandbox,
# sk_live_… for live (live keys need approved KYC). Leave empty to run without
# Sendii — orders then go to Locoomo riders. The webhook secret is shown once
# when you register the endpoint: `npm run sendii:webhook -- register <public-https-url>`.
SENDII_API_KEY=
SENDII_WEBHOOK_SECRET=

# Encrypts sensitive fields at rest: 2FA (TOTP) seeds, merchant KYC ID numbers,
# bank account numbers. Generate like JWT_ACCESS_SECRET. Set it before anyone
# enrols in 2FA / submits KYC and NEVER change it afterwards (that data would
# become unreadable). If unset it's derived from JWT_ACCESS_SECRET.
DATA_ENCRYPTION_KEY=

# ── Platform (merchant platform M0) — all optional ─────────────────────────
# Redis for state shared across API instances: rate-limit counters, auth
# caches, session revocation. Leave empty for a single instance (local dev,
# CI). REQUIRED before running more than one API replica.
# Local: `docker compose up -d redis` → redis://localhost:6381/0
REDIS_URL=
# api = HTTP only; worker = background jobs (outbox, expiry, reconciliation);
# all = both (default — fine for one instance). Production: one `api` service
# plus one or more `worker` services.
PROCESS_ROLE=all
# CSRF header check on cookie-authenticated mutating requests
# (X-Locoomo-Client). off | report (log only, default) | enforce (403).
# Switch to enforce once every browser frontend sends the header.
CSRF_MODE=report
# Outbox throughput (emails, SMS, courier submissions).
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_CONCURRENCY=10
# SMS (optional by design — without a working key SMS is skipped and every
# flow continues on email/other channels). none | termii
SMS_PROVIDER=none
SMS_API_KEY=
# Must be a sender ID approved on the Termii account (max 11 chars).
SMS_SENDER_ID=Locoomo
# Your account's base URL from the Termii dashboard.
TERMII_BASE_URL=https://v3.api.termii.com
# generic | dnd (dnd must be activated on the Termii account first)
TERMII_CHANNEL=generic

# --- Merchant platform ---
# Kill switch: false answers every /merchant route with 503 (admin routes keep working).
MERCHANT_PLATFORM_ENABLED=true
# Merchant dashboard origin used in merchant emails; defaults to FRONTEND_URL.
MERCHANT_DASHBOARD_URL=
# Reverse proxies in front of the API (Express trust proxy) so request.ip is the real
# client for rate limits, audit and API-key IP allow-lists. Unset = 1 on Railway, else 0.
TRUST_PROXY_HOPS=

# Itemise the 7.5% VAT already included in merchant prices (finance to confirm, plan F3).
VAT_ENABLED=false
