NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://locoomo:locoomo@localhost:5434/locoomo
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
# Only needed against a hosted DB (Supabase/Neon) that requires TLS — repo-relative
# path to that provider's CA cert (e.g. certs/supabase-ca.crt). Unset locally, the
# docker-compose Postgres has no TLS.
DATABASE_SSL_CA_PATH=
# Comma-separated browser origins allowed to call this API with credentials
CORS_ORIGIN=http://localhost:5173
# Single canonical frontend origin — used to build links embedded in emails
# (password reset, email verification, invite)
FRONTEND_URL=http://localhost:5173
# SMTP only — no provider SDK, so swapping providers is just changing these
# values. Resend's own relay for the pilot: host smtp.resend.com, user
# "resend", password = a Resend API key. Any other SMTP-capable provider
# (SES, Postmark, SendGrid, Mailgun, ...) works the same way. Use Resend's
# implicit-TLS port 465 (secure=true), not 587 — some ISPs/routers block
# outbound 587 to stop spam relaying (see doc/DEVELOPMENT.md gotchas).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Some hosts block outbound SMTP entirely (Railway free/hobby tier does, on
# every port — see doc/DEVELOPMENT.md gotchas). Set EMAIL_TRANSPORT=resend_api
# there to send over Resend's HTTPS API instead (443, never blocked). Leave
# unset/"smtp" everywhere else — this only exists as a fallback.
EMAIL_TRANSPORT=smtp
# Required only when EMAIL_TRANSPORT=resend_api. Same Resend API key as
# SMTP_PASSWORD above, just under its own var name.
RESEND_API_KEY=
# Rider verification document uploads (screenshots) — signed direct-to-Cloudinary
# upload, never proxied through this API. From your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Paystack TEST secret key (dashboard > Settings > API Keys & Webhooks) —
# hosted-redirect checkout, so no client-side public key is needed here.
PAYSTACK_SECRET_KEY=
# Google Sign-In — OAuth 2.0 Client ID from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application). Public
# value, not a secret. No client secret needed — we only verify a client-side
# ID token server-side, never a server-side auth-code exchange.
GOOGLE_CLIENT_ID=
